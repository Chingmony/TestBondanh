# TestBondanh .gitignore — baseline from TRD TR-SEC-04.
# Real scan data, databases, and reports must never be committed (BR-014).

# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Scan data, databases, reports
*.db
*.sqlite*
reports/
*.xml
!tests/fixtures/**/*.xml

# Secrets
.env
.env.*

# Personal Claude Code settings and harness state (AI Harness Design §6.2, §7.1)
.claude/settings.local.json
CLAUDE.local.md
.claude/state/
